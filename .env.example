# Core account storage and sessions
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/aethercm
JWT_SECRET=generate-a-long-random-secret
APP_URL=https://your-aether-domain.com

# Administrator sign-in
ADMIN_EMAIL=admin@aethercm.local
ADMIN_PASSWORD=use-a-new-private-password

# Email — use Resend (recommended) OR SMTP
EMAIL_FROM=Aether <accounts@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com
RESEND_API_KEY=

# SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# First-party push alerts
VAPID_SUBJECT=mailto:support@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
